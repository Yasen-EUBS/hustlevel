{
  "appId": "com.yasen.nss",
  "appName": "HustLevel",
  "webDir": "www",
  "server": {
    "url": "https://nss-gym.lovable.app",
    "androidScheme": "https",
    "errorPath": "offline.html",
    "allowNavigation": [
      "nss-gym.lovable.app",
      "*.supabase.co",
      "*.youtube-nocookie.com",
      "*.youtube.com",
      "i.ytimg.com"
    ]
  },
  "backgroundColor": "#0B0F14",
  "android": {
    "backgroundColor": "#0B0F14",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0B0F14",
      "showSpinner": false,
      "androidScaleType": "CENTER_INSIDE"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B0F14",
      "overlaysWebView": false
    }
  }
}
