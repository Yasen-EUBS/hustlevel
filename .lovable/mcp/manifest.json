{
  "version": 1,
  "sdk_version": "3.5.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://gtyoyqjufbxkhqbornil.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "hustlevel",
      "version": "0.1.0",
      "title": "HustLevel"
    },
    "tools": [
      {
        "name": "list_recent_workouts",
        "title": "List recent workouts",
        "description": "List the signed-in lifter's most recent workout sessions with their logged sets (weights in kg).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many sessions to return (default 5).",
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_exercise_history",
        "title": "Get exercise history",
        "description": "Get the signed-in lifter's logged sets for one exercise by name, newest first (weights in kg).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "exercise": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Exercise name, e.g. 'Converging Flat Press'."
            },
            "limit": {
              "description": "Max sets to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "required": [
            "exercise"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_meals",
        "title": "List meals for a day",
        "description": "List the signed-in user's logged meals and totals for one date (calories and macros in grams).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date as YYYY-MM-DD."
            }
          },
          "required": [
            "date"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
